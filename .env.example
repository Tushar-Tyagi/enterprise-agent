# =============================================================================
# Enterprise Agent LLM Provider Configuration (.env)
#
# All LLM calls use an OpenAI-compliant chat completions endpoint.
# To switch or add a provider, configure the corresponding variables below.
# Copy this file to .env:
#     cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Active Provider Configuration (Default: OpenRouter)
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=google/gemini-3.1-flash-lite
LLM_FALLBACK_MODEL=google/gemini-2.5-flash
LLM_TEMPERATURE=0.0

# -----------------------------------------------------------------------------
# Provider Preset: Google Gemini / Google AI Studio (Direct Key)
# Google provides an official OpenAI-compatible endpoint for Gemini models.
# To use direct Gemini keys, uncomment the lines below:
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIzaSy...
# LLM_MODEL=gemini-2.5-flash
# LLM_FALLBACK_MODEL=gemini-2.5-pro
#
# Quick Shortcut: You can also simply set GEMINI_API_KEY without specifying
# LLM_BASE_URL; the agent will automatically route to Google AI Studio:
# GEMINI_API_KEY=AIzaSy...

# -----------------------------------------------------------------------------
# Provider Preset: OpenAI Direct
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-proj-...
# LLM_MODEL=gpt-4o-mini
# LLM_FALLBACK_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Provider Preset: Local vLLM / Ollama
# -----------------------------------------------------------------------------
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=none
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# LLM_FALLBACK_MODEL=meta-llama/Llama-3.3-70B-Instruct

# -----------------------------------------------------------------------------
# Provider Preset: Groq
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# -----------------------------------------------------------------------------
# Provider Preset: DeepSeek
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# LLM_FALLBACK_MODEL=deepseek-chat
